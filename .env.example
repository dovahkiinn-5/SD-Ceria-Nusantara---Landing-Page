APP_NAME="SD Ceria Nusantara"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION is only needed for tests and one-time legacy SQLite imports.

SESSION_DRIVER=firestore
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

CACHE_STORE=firestore
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCHOOL_STORE=firestore
SCHOOL_ADDRESS="Jl. Adhiyaksa No.9, Kacang Pedang, Kec. Gerunggang, Kota Pangkal Pinang"
SCHOOL_LATITUDE=-2.1256678
SCHOOL_LONGITUDE=106.1037412
SCHOOL_MAP_URL="https://www.google.com/maps/place/Universitas+Pertiba+-+Uniper,+Pangkalpinang,+Bangka+Belitung/@-2.1256678,106.0992351,713m/data=!3m1!1e3!4m10!1m2!2m1!1spertiba!3m6!1s0x2e22c125a0f4c45f:0x61d9605e6f5c65f1!8m2!3d-2.1256678!4d106.1037412!15sCgdwZXJ0aWJhkgEKdW5pdmVyc2l0eeABAA!16s%2Fg%2F11b6g8vnm2?entry=ttu&g_ep=EgoyMDI2MTAxMy4wIKXMDSoASAFQAw%3D%3D"
WHATSAPP_GROUP_URL="https://chat.whatsapp.com/CxsxIG5MnIYErggxZ8VkdZ?mode=gi_t"
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
